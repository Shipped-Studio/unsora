# ============================================================
# MCP Server
# ============================================================
PORT=3002
HOST=localhost

# Public URL the MCP server is reachable at (used for OAuth metadata)
MCP_PUBLIC_URL=https://mcp.your-domain.com
MCP_PATH=/mcp
# Comma-separated hostnames allowed in the Host header (add your ngrok host in dev)
MCP_ALLOWED_HOSTS=mcp.your-domain.com,localhost,127.0.0.1

MCP_SERVER_NAME=unsora-mcp

# ============================================================
# Auth — Clerk (same instance as the server/client)
# ============================================================
CLERK_PUBLISHABLE_KEY=pk_test_xxx
CLERK_SECRET_KEY=sk_test_xxx

# ============================================================
# Unsora API
# ============================================================
# Base URL of the public /api/v1 surface the MCP tools call
UNSORA_API_BASE_URL=https://your-domain.com/api/v1

# Comma-separated hosts allowed to serve generated media (image/video/audio)
# inside the sandboxed preview iframe. Must cover every CDN the API returns
# outputUrl from — anything not listed here is blocked (broken image/video).
MCP_MEDIA_DOMAINS=https://*.supabase.co,https://*.blob.core.windows.net,https://files.tryunsora.com
