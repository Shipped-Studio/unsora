{
  "name": "unsora",
  "private": true,
  "description": "Unsora: AI content generation and social scheduling. Web app, API server, MCP server and Remotion compositions.",
  "packageManager": "pnpm@10.34.6",
  "scripts": {
    "postinstall": "pnpm --filter @unsora/server db:generate",
    "build": "turbo run build",
    "dev": "turbo run dev",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "dev:client": "turbo run dev --filter=@unsora/client",
    "dev:server": "turbo run dev --filter=@unsora/server",
    "dev:mcp": "turbo run dev --filter=@unsora/mcp",
    "dev:trigger": "pnpm --filter @unsora/server trigger:dev"
  },
  "devDependencies": {
    "turbo": "^2.11.7"
  }
}
