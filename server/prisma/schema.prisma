generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum VideoOperation {
  WATERMARK_REMOVAL
  UPSCALING
}

model User {
  id        String   @id @default(cuid())
  clerkId   String   @unique
  email     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  role UserRole @default(USER)

  processedVideos    ProcessedVideo[]
  transcriptions     Transcription[]
  videoExports       VideoExport[]
  socialAccounts     SocialAccount[]
  posts              Post[]
  generations        Generation[]
  imageGenerations   ImageGeneration[]
  musicGenerations   MusicGeneration[]
  avatarGenerations  AvatarGeneration[]
  voiceGenerations   VoiceGeneration[]
  voiceConversions   VoiceConversion[]
  voiceClones        VoiceClone[]
  assets             Asset[]
  creditGrants       CreditGrant[]
  creditTransactions CreditTransaction[]
  aiClippings        AIClipping[]
  apiKeys            ApiKey[]

  stripeCustomerId       String?   @unique @map(name: "stripe_customer_id")
  stripeSubscriptionId   String?   @unique @map(name: "stripe_subscription_id")
  stripePriceId          String?   @map(name: "stripe_price_id")
  stripeCurrentPeriodEnd DateTime? @map(name: "stripe_current_period_end")
  isActive               Boolean   @default(false)
  isCancelled            Boolean   @default(false)
  plan                   String?   @default("free")

  status String @default("inactive")

  @@index([clerkId])
  @@index([email])
  @@index([createdAt(sort: Desc)])
  @@index([updatedAt(sort: Desc)])
  @@index([isActive])
  @@index([isCancelled])
  @@index([plan])
  @@index([status])
  @@index([role])
  @@index([stripeCustomerId])
  @@index([stripeSubscriptionId])
  @@index([stripeCurrentPeriodEnd])
  @@map("users")
}

enum UserRole {
  USER
  ADMIN
}

model ApiKey {
  id         String    @id @default(cuid())
  userId     String
  name       String
  keyPrefix  String
  keyHash    String    @unique
  lastUsedAt DateTime?
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  user               User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  creditTransactions CreditTransaction[]
  idempotencyRecords ApiIdempotencyRecord[]

  @@index([userId])
  @@index([userId, revokedAt])
  @@map("api_keys")
}

model ApiIdempotencyRecord {
  id             String   @id @default(cuid())
  apiKeyId       String
  idempotencyKey String
  method         String
  path           String
  statusCode     Int
  responseBody   Json
  expiresAt      DateTime
  createdAt      DateTime @default(now())

  apiKey ApiKey @relation(fields: [apiKeyId], references: [id], onDelete: Cascade)

  @@unique([apiKeyId, idempotencyKey])
  @@index([expiresAt])
  @@map("api_idempotency_records")
}

model Plan {
  id          String  @id @default(cuid())
  key         String  @unique
  name        String
  description String?

  type       PlanType
  credits    Int      @default(0)
  priceCents Int      @default(0)
  currency   String   @default("usd")

  interval  PlanInterval?
  trialDays Int?

  stripePriceId   String? @unique
  stripeProductId String?

  sortOrder Int     @default(0)
  isActive  Boolean @default(true)
  isPopular Boolean @default(false)

  metadata  Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@index([type])
  @@index([type, isActive, sortOrder])
  @@index([stripePriceId])
  @@index([isActive])
  @@map("plans")
}

enum PlanType {
  SUBSCRIPTION
  TOPUP
  PROMO
}

enum PlanInterval {
  MONTH
  YEAR
}

model CreditGrant {
  id     String @id @default(cuid())
  userId String

  amount Int
  used   Int @default(0)

  source CreditSource
  reason String?

  expiresAt DateTime?
  createdAt DateTime  @default(now())

  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions CreditTransaction[] @relation("TransactionGrant")

  @@index([userId])
  @@index([userId, expiresAt])
  @@index([expiresAt])
  @@index([source])
  @@map("credit_grants")
}

model CreditTransaction {
  id     String                @id @default(cuid())
  userId String
  type   CreditTransactionType

  amount Int

  reason String

  grantId String?

  refundOfId String?

  metadata Json?

  apiKeyId String?
  apiKey   ApiKey? @relation(fields: [apiKeyId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  user     User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  grant    CreditGrant?        @relation("TransactionGrant", fields: [grantId], references: [id], onDelete: SetNull)
  refundOf CreditTransaction?  @relation("TransactionRefunds", fields: [refundOfId], references: [id], onDelete: SetNull)
  refunds  CreditTransaction[] @relation("TransactionRefunds")

  @@index([userId])
  @@index([userId, createdAt(sort: Desc)])
  @@index([userId, type])
  @@index([type])
  @@index([apiKeyId])
  @@index([refundOfId])
  @@index([grantId])
  @@map("credit_transactions")
}

enum CreditSource {
  SUBSCRIPTION
  TOP_UP
  PROMOTION
  REFUND
  ADMIN
}

enum CreditTransactionType {
  GRANT
  CONSUMPTION
  REFUND
  EXPIRY
  ADJUSTMENT
}

model SocialAccount {
  id                String    @id @default(cuid())
  userId            String
  provider          String
  providerAccountId String
  accountName       String?
  accountUsername   String?
  profilePicture    String?
  accessToken       String
  refreshToken      String?
  expiresAt         DateTime?
  scope             String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @default(now()) @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  postAccounts PostAccount[]

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@index([provider])
  @@index([userId, provider])
  @@index([expiresAt])
  @@map("social_accounts")
}

// AT Protocol (Bluesky) OAuth flow state, managed by @atproto/oauth-client-node.
// `state` / `session` hold the library's serialized NodeSavedState/NodeSavedSession.
model BlueskyAuthState {
  key       String   @id
  state     String
  createdAt DateTime @default(now())

  @@map("bluesky_auth_states")
}

model BlueskyAuthSession {
  key       String   @id // account DID
  session   String
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@map("bluesky_auth_sessions")
}

model ProcessedVideo {
  id                    String           @id @default(cuid())
  userId                String
  originalName          String
  operations            VideoOperation[]
  creditsUsed           Int
  status                String
  error                 String?
  durationSeconds       Decimal?
  fileSizeBytes         BigInt?
  resolution            String?
  upscaleModel          String?          @default("standard")
  watermarkRemovalModel String?          @default("standard")
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @default(now()) @updatedAt

  taskId   String? @unique
  metadata Json?

  originalAssetId     String?
  processedAssetId    String?
  intermediateAssetId String?

  originalAsset     Asset? @relation("ProcessedVideoOriginal", fields: [originalAssetId], references: [id])
  processedAsset    Asset? @relation("ProcessedVideoProcessed", fields: [processedAssetId], references: [id])
  intermediateAsset Asset? @relation("ProcessedVideoIntermediate", fields: [intermediateAssetId], references: [id])

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt(sort: Desc)])
  @@index([updatedAt(sort: Desc)])
  @@index([status])
  @@index([userId, status])
  @@index([userId, createdAt(sort: Desc)])
  @@index([operations])
  @@index([creditsUsed])
  @@index([originalName])
  @@index([status, createdAt(sort: Desc)])
  @@index([userId, operations])
  @@map("processed_videos")
}

model Transcription {
  id               String   @id @default(cuid())
  userId           String
  title            String?
  filename         String?
  text             String   @db.Text
  language         String
  duration         Float
  width            Int?
  height           Int?
  segments         Json?
  subtitleChunks   Json?
  editorSettings   Json?
  maxWordsPerChunk Int      @default(5)
  status           String   @default("queued")
  error            String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @default(now()) @updatedAt

  taskId   String? @unique @default(uuid())
  metadata Json?

  videoAssetId String?
  videoAsset   Asset?  @relation("TranscriptionVideo", fields: [videoAssetId], references: [id])

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  videoExports VideoExport[]

  @@index([userId])
  @@index([createdAt(sort: Desc)])
  @@index([userId, createdAt(sort: Desc)])
  @@index([status])
  @@index([userId, status])
  @@index([filename])
  @@index([language])
  @@index([userId, language])
  @@index([status, createdAt(sort: Desc)])
  @@map("transcriptions")
}

model VideoExport {
  id              String   @id @default(cuid())
  userId          String
  transcriptionId String?
  settings        Json
  duration        Float
  fps             Int      @default(30)
  width           Int?
  height          Int?
  createdAt       DateTime @default(now())
  status          String   @default("queued")
  error           String?
  taskId          String?  @unique @default(uuid())
  metadata        Json?

  sourceAssetId String?
  outputAssetId String?

  sourceAsset Asset? @relation("VideoExportSource", fields: [sourceAssetId], references: [id])
  outputAsset Asset? @relation("VideoExportOutput", fields: [outputAssetId], references: [id])

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  transcription Transcription? @relation(fields: [transcriptionId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([transcriptionId])
  @@index([createdAt(sort: Desc)])
  @@index([status])
  @@index([userId, status])
  @@index([userId, createdAt(sort: Desc)])
  @@index([status, createdAt(sort: Desc)])
  @@map("video_exports")
}

model Post {
  id     String @id @default(cuid())
  userId String

  type PostType @default(VIDEO)

  mainCaption String @db.Text

  error     String?  @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  status            PostStatus @default(DRAFT)
  scheduledFor      DateTime?
  scheduledTimezone String?
  publishedAt       DateTime?

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  postAccounts PostAccount[]
  media        PostMedia[]

  @@index([userId])
  @@index([status])
  @@index([type])
  @@index([scheduledFor])
  @@index([userId, status])
  @@index([userId, type])
  @@index([userId, createdAt(sort: Desc)])
  @@index([userId, scheduledFor])
  @@index([status, scheduledFor])
  @@index([userId, status, scheduledFor])
  @@index([publishedAt(sort: Desc)])
  @@map("posts")
}

model PostMedia {
  id     String @id @default(cuid())
  postId String

  type  MediaType
  order Int       @default(0)

  createdAt DateTime @default(now())

  updatedAt DateTime @default(now()) @updatedAt

  assetId String
  asset   Asset  @relation("PostMediaAsset", fields: [assetId], references: [id])

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([postId])
  @@index([type])
  @@index([postId, order])
  @@map("post_media")
}

model PostAccount {
  id        String @id @default(cuid())
  postId    String
  accountId String

  customCaption String? @db.Text
  title         String? @db.Text

  settings Json?

  published       Boolean   @default(false)
  publishedAt     DateTime?
  publishedPostId String?
  publishedUrl    String?
  error           String?   @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  post    Post          @relation(fields: [postId], references: [id], onDelete: Cascade)
  account SocialAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  metricSnapshots PostMetricSnapshot[]

  @@unique([postId, accountId])
  @@index([postId])
  @@index([accountId])
  @@index([published])
  @@index([accountId, published])
  @@index([accountId, publishedAt(sort: Desc)])
  @@index([published, publishedAt(sort: Desc)])
  @@map("post_accounts")
}

/// Point-in-time engagement metrics for a published post on one platform.
/// Counters are cumulative platform totals; a new snapshot is written on
/// each poll so growth over time can be charted.
model PostMetricSnapshot {
  id            String @id @default(cuid())
  postAccountId String

  views    Int @default(0)
  likes    Int @default(0)
  comments Int @default(0)
  shares   Int @default(0)
  saves    Int @default(0)

  fetchedAt DateTime @default(now())

  postAccount PostAccount @relation(fields: [postAccountId], references: [id], onDelete: Cascade)

  @@index([postAccountId, fetchedAt(sort: Desc)])
  @@index([fetchedAt])
  @@map("post_metric_snapshots")
}

enum MediaType {
  VIDEO
  IMAGE
  THUMBNAIL
}

model Generation {
  id     String @id @default(cuid())
  userId String

  model        String               @default("seedance_2.0_fast")
  prompt       String               @db.Text
  functionMode VideoGenerationType? @default(OMNI_REFERENCE)
  ratio        String               @default("16:9")
  duration     Int                  @default(5)

  negativePrompt       String? @db.Text
  sound                Boolean @default(false)
  resolution           String?
  cfgScale             Float?
  characterOrientation String?

  taskId      String?          @unique
  status      GenerationStatus @default(QUEUED)
  error       String?          @db.Text
  creditsUsed Int              @default(0)
  metadata    Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  outputAssetId    String?
  thumbnailAssetId String?
  imageAssetId     String?
  endImageAssetId  String?

  outputAsset    Asset? @relation("GenerationOutput", fields: [outputAssetId], references: [id])
  thumbnailAsset Asset? @relation("GenerationThumbnail", fields: [thumbnailAssetId], references: [id])
  imageAsset     Asset? @relation("GenerationImage", fields: [imageAssetId], references: [id])
  endImageAsset  Asset? @relation("GenerationEndImage", fields: [endImageAssetId], references: [id])

  inputAssets GenerationInputAsset[]

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@index([taskId])
  @@index([userId, status])
  @@index([userId, createdAt(sort: Desc)])
  @@index([status, createdAt(sort: Desc)])
  @@map("generations")
}

model GenerationInputAsset {
  id           String              @id @default(cuid())
  generationId String
  assetId      String
  role         GenerationInputRole
  order        Int                 @default(0)

  generation Generation @relation(fields: [generationId], references: [id], onDelete: Cascade)
  asset      Asset      @relation("GenerationInputAssets", fields: [assetId], references: [id], onDelete: Cascade)

  @@unique([generationId, assetId, role])
  @@index([generationId])
  @@index([assetId])
  @@map("generation_input_assets")
}

enum GenerationInputRole {
  IMAGE_FILE
  VIDEO_FILE
  AUDIO_FILE
  FRAME_PATH
}

model ImageGeneration {
  id     String @id @default(cuid())
  userId String

  model        String  @default("nano-banana-pro")
  prompt       String  @db.Text
  ratio        String  @default("auto")
  resolution   String  @default("1k")
  originalName String?

  type   ImageGenerationType? @default(BASIC)
  mode   String?
  params Json?

  taskId      String?          @unique
  status      GenerationStatus @default(QUEUED)
  error       String?          @db.Text
  creditsUsed Int              @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  inputAssetId     String?
  outputAssetId    String?
  thumbnailAssetId String?

  inputAsset     Asset? @relation("ImageGenerationInput", fields: [inputAssetId], references: [id])
  outputAsset    Asset? @relation("ImageGenerationOutput", fields: [outputAssetId], references: [id])
  thumbnailAsset Asset? @relation("ImageGenerationThumbnail", fields: [thumbnailAssetId], references: [id])

  referenceAssets ImageGenerationRefAsset[]

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@index([taskId])
  @@index([userId, status])
  @@index([userId, createdAt(sort: Desc)])
  @@index([status, createdAt(sort: Desc)])
  @@map("image_generations")
}

model ImageGenerationRefAsset {
  id                String @id @default(cuid())
  imageGenerationId String
  assetId           String
  order             Int    @default(0)

  imageGeneration ImageGeneration @relation(fields: [imageGenerationId], references: [id], onDelete: Cascade)
  asset           Asset           @relation("ImageGenerationRefAssets", fields: [assetId], references: [id], onDelete: Cascade)

  @@unique([imageGenerationId, assetId])
  @@index([imageGenerationId])
  @@index([assetId])
  @@map("image_generation_ref_assets")
}

model Asset {
  id     String @id @default(cuid())
  userId String

  name     String
  url      String
  mimeType String
  type     AssetType
  source   AssetSource @default(SYSTEM)

  fileSize BigInt?
  width    Int?
  height   Int?
  duration Float?

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  processedVideoOriginals     ProcessedVideo[] @relation("ProcessedVideoOriginal")
  processedVideoProcessed     ProcessedVideo[] @relation("ProcessedVideoProcessed")
  processedVideoIntermediates ProcessedVideo[] @relation("ProcessedVideoIntermediate")

  transcriptionVideos Transcription[] @relation("TranscriptionVideo")

  videoExportSources VideoExport[] @relation("VideoExportSource")
  videoExportOutputs VideoExport[] @relation("VideoExportOutput")

  generationOutputs    Generation[] @relation("GenerationOutput")
  generationThumbnails Generation[] @relation("GenerationThumbnail")
  generationImages     Generation[] @relation("GenerationImage")
  generationEndImages  Generation[] @relation("GenerationEndImage")

  generationInputAssets    GenerationInputAsset[]    @relation("GenerationInputAssets")
  imageGenerationRefAssets ImageGenerationRefAsset[] @relation("ImageGenerationRefAssets")

  imageGenerationInputs     ImageGeneration[] @relation("ImageGenerationInput")
  imageGenerationOutputs    ImageGeneration[] @relation("ImageGenerationOutput")
  imageGenerationThumbnails ImageGeneration[] @relation("ImageGenerationThumbnail")

  musicGenerationOutputs MusicGeneration[] @relation("MusicGenerationOutput")

  avatarGenerationInputs  AvatarGeneration[] @relation("AvatarGenerationInput")
  avatarGenerationAudio   AvatarGeneration[] @relation("AvatarGenerationAudio")
  avatarGenerationOutputs AvatarGeneration[] @relation("AvatarGenerationOutput")

  voiceGenerationOutputs VoiceGeneration[] @relation("VoiceGenerationOutput")

  voiceCloneSamples VoiceClone[] @relation("VoiceCloneSample")

  voiceConversionSources VoiceConversion[] @relation("VoiceConversionSource")
  voiceConversionOutputs VoiceConversion[] @relation("VoiceConversionOutput")

  aiClippingSources        AIClipping[]     @relation("AIClippingSource")
  aiClippingClipOutputs    AIClippingClip[] @relation("AIClippingClipOutput")
  aiClippingClipThumbnails AIClippingClip[] @relation("AIClippingClipThumbnail")

  postMediaItems PostMedia[] @relation("PostMediaAsset")

  @@index([userId])
  @@index([type])
  @@index([userId, type])
  @@index([userId, source])
  @@index([userId, url])
  @@index([userId, createdAt(sort: Desc)])
  @@map("assets")
}

model MusicGeneration {
  id     String @id @default(cuid())
  userId String

  model        String  @default("mureka-v9")
  lyrics       String  @db.Text
  prompt       String  @db.Text
  outputFormat String  @default("mp3")
  voiceId      String?

  taskId      String?          @unique
  status      GenerationStatus @default(QUEUED)
  error       String?          @db.Text
  creditsUsed Int              @default(0)
  params      Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  outputAssetId String?
  outputAsset   Asset?  @relation("MusicGenerationOutput", fields: [outputAssetId], references: [id])

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@index([taskId])
  @@index([userId, status])
  @@index([userId, createdAt(sort: Desc)])
  @@index([status, createdAt(sort: Desc)])
  @@map("music_generations")
}

model AvatarGeneration {
  id     String @id @default(cuid())
  userId String

  model      String @default("skyreels-v3")
  transcript String @db.Text
  emotion    String @default("neutral")
  prompt     String @default("") @db.Text
  resolution String @default("720p")
  voiceId    String @default("Friendly_Person")

  imageAssetId String?
  imageAsset   Asset?  @relation("AvatarGenerationInput", fields: [imageAssetId], references: [id])

  audioAssetId String?
  audioAsset   Asset?  @relation("AvatarGenerationAudio", fields: [audioAssetId], references: [id])

  taskId      String?          @unique
  ttsTaskId   String?
  status      GenerationStatus @default(QUEUED)
  error       String?          @db.Text
  creditsUsed Int              @default(0)
  params      Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  outputAssetId String?
  outputAsset   Asset?  @relation("AvatarGenerationOutput", fields: [outputAssetId], references: [id])

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@index([taskId])
  @@index([userId, status])
  @@index([userId, createdAt(sort: Desc)])
  @@index([status, createdAt(sort: Desc)])
  @@map("avatar_generations")
}

model VoiceGeneration {
  id     String @id @default(cuid())
  userId String

  model        String @default("minimax-speech-2.6-hd")
  text         String @db.Text
  voiceId      String @default("Friendly_Person")
  emotion      String @default("neutral")
  speed        Float  @default(1)
  outputFormat String @default("mp3")

  taskId      String?          @unique
  status      GenerationStatus @default(QUEUED)
  error       String?          @db.Text
  creditsUsed Int              @default(0)
  params      Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  outputAssetId String?
  outputAsset   Asset?  @relation("VoiceGenerationOutput", fields: [outputAssetId], references: [id])

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@index([taskId])
  @@index([userId, status])
  @@index([userId, createdAt(sort: Desc)])
  @@index([status, createdAt(sort: Desc)])
  @@map("voice_generations")
}

model VoiceClone {
  id     String @id @default(cuid())
  userId String

  name              String
  description       String? @db.Text
  elevenLabsVoiceId String  @unique @map("elevenlabs_voice_id")

  sampleAssetId String?
  sampleAsset   Asset?  @relation("VoiceCloneSample", fields: [sampleAssetId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, createdAt(sort: Desc)])
  @@map("voice_clones")
}

model VoiceConversion {
  id     String @id @default(cuid())
  userId String

  voiceId           String
  elevenLabsVoiceId String @map("elevenlabs_voice_id")
  outputFormat      String @default("mp3")

  sourceAssetId String?
  sourceAsset   Asset?  @relation("VoiceConversionSource", fields: [sourceAssetId], references: [id])

  status      GenerationStatus @default(QUEUED)
  error       String?          @db.Text
  creditsUsed Int              @default(0)
  params      Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  outputAssetId String?
  outputAsset   Asset?  @relation("VoiceConversionOutput", fields: [outputAssetId], references: [id])

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@index([userId, status])
  @@index([userId, createdAt(sort: Desc)])
  @@map("voice_conversions")
}

model AIClipping {
  id       String  @id @default(cuid())
  userId   String
  videoUrl String?

  sourceAssetId String?
  sourceAsset   Asset?  @relation("AIClippingSource", fields: [sourceAssetId], references: [id])

  config Json

  taskId      String?          @unique
  status      GenerationStatus @default(QUEUED)
  error       String?          @db.Text
  creditsUsed Int              @default(0)
  metadata    Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  user  User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  clips AIClippingClip[]

  @@index([userId])
  @@index([status])
  @@index([taskId])
  @@index([createdAt(sort: Desc)])
  @@index([userId, status])
  @@index([userId, createdAt(sort: Desc)])
  @@index([status, createdAt(sort: Desc)])
  @@map("ai_clippings")
}

model AIClippingClip {
  id           String @id @default(cuid())
  aiClippingId String
  order        Int    @default(0)

  title     String?
  startTime Float?
  endTime   Float?
  duration  Float?

  outputAssetId    String?
  thumbnailAssetId String?

  status   GenerationStatus @default(QUEUED)
  error    String?          @db.Text
  taskId   String?          @unique
  metadata Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  aiClipping     AIClipping @relation(fields: [aiClippingId], references: [id], onDelete: Cascade)
  outputAsset    Asset?     @relation("AIClippingClipOutput", fields: [outputAssetId], references: [id])
  thumbnailAsset Asset?     @relation("AIClippingClipThumbnail", fields: [thumbnailAssetId], references: [id])

  @@index([aiClippingId])
  @@index([aiClippingId, order])
  @@index([status])
  @@index([taskId])
  @@map("ai_clipping_clips")
}

enum AssetType {
  IMAGE
  VIDEO
  AUDIO
  DOCUMENT
}

enum AssetSource {
  UPLOAD
  GENERATION
  PROCESSING
  EXPORT
  SYSTEM
}

enum PostType {
  VIDEO
  IMAGE
  CAROUSEL
  TEXT
}

enum PostStatus {
  DRAFT
  SCHEDULED
  PUBLISHING
  PUBLISHED
  PARTIALLY_PUBLISHED
  FAILED
}

enum GenerationStatus {
  QUEUED
  PROCESSING
  COMPLETED
  FAILED
}

enum ImageGenerationType {
  BASIC
  MOVIE_MATERIALS
  INFLUENCER
  UPSCALE
  THUMBNAIL
}

enum VideoGenerationType {
  OMNI_REFERENCE
  FIRST_LAST_FRAMES
  TEXT_TO_VIDEO
  IMAGE_TO_VIDEO
  MOTION_CONTROL
}

// ---------------------------------------------------------------------------
// Skills marketplace — admin-managed skill pages served to the landing site.
// A skill comes from a GitHub repo (synced) or a direct file upload; its
// files live in Supabase storage under skills/<slug>/.
// ---------------------------------------------------------------------------

model Skill {
  id   String @id @default(cuid())
  slug String @unique

  name        String
  tagline     String
  description String

  sourceType  SkillSourceType @default(GITHUB)
  githubUrl   String?
  // Storage path of SKILL.md within the public bucket (e.g. "skills/<slug>/SKILL.md")
  skillMdPath String?
  // Extra uploaded files (references/, scripts/) as [{ path, url }]
  files       Json            @default("[]")

  installCommand String?

  // Page content, matching the landing Skill interface
  highlights   Json   @default("[]") // string[]
  steps        Json   @default("[]") // { num, title, body }[]
  examples     Json   @default("[]") // string[]
  requirements Json   @default("[]") // string[]
  ctaHeadline  String @default("")
  ctaBody      String @default("")

  status    SkillStatus @default(DRAFT)
  sortOrder Int         @default(0)

  media SkillMedia[]

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@index([status, sortOrder])
  @@map("skills")
}

model SkillMedia {
  id      String @id @default(cuid())
  skillId String

  type   SkillMediaType
  url    String
  label  String         @default("")
  // CSS aspect-ratio of the asset: "9/16" | "1/1" | "16/9"
  aspect String         @default("9/16")

  sortOrder Int @default(0)

  skill Skill @relation(fields: [skillId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([skillId, sortOrder])
  @@map("skill_media")
}

enum SkillSourceType {
  GITHUB
  UPLOAD
}

enum SkillStatus {
  DRAFT
  PUBLISHED
}

enum SkillMediaType {
  IMAGE
  VIDEO
}
