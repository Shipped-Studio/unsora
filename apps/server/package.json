    "@types/ioredis": "^5.0.0",
    "@unkey/api": "^2.3.5",
    "ai": "^5.0.166",
    "axios": "^1.12.2",
    "cors": "^2.8.5",
    "crypto": "^1.0.1",
    "date-fns": "^4.1.0",
    "date-fns-tz": "^3.2.0",
    "dotenv": "^17.2.2",
    "express": "^5.1.0",
    "fluent-ffmpeg": "^2.1.3",
    "ioredis": "^5.9.3",
