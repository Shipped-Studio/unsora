{
  "name": "@unsora/server",
  "private": true,
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "dev": "nodemon --exec ts-node src/server.ts",
    "trigger:dev": "npx trigger.dev dev",
    "trigger:deploy": "npx trigger.dev deploy",
    "clean": "rm -rf dist",
    "build": "tsc",
    "start": "node dist/src/server.js",
    "migrate": "prisma migrate dev && prisma generate",
    "deploy": "npm run build && npm start",
    "docs:export-openapi": "npm run build && node -e \"const fs=require('fs');const path=require('path');const doc=require('./dist/src/docs/openapi').default;const dir=path.resolve(process.env.DOCS_DIR||'../../../docs');if(!fs.existsSync(dir)){console.error('Docs repo not found at '+dir+'. Clone it there or set DOCS_DIR.');process.exit(1);}const out=path.join(dir,'openapi.json');fs.writeFileSync(out, JSON.stringify(doc, null, 2));console.log('OpenAPI exported to', out);\"",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "email:test": "ts-node scripts/send-test-email.ts"
  },
  "keywords": [],
  "author": "",
  "license": "AGPL-3.0-only",
