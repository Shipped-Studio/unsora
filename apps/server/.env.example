# ============================================================
# Server
# ============================================================
PORT=8000
CLIENT_URL=http://localhost:3000
# Optional: point the server at an alternate env file
# UNSORA_ENV_FILE=

# ============================================================
# Database
# ============================================================
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME

# Optional cache / queues
REDIS_URL=redis://localhost:6379

# ============================================================
# Auth — Clerk (dashboard.clerk.com)
# ============================================================
CLERK_PUBLISHABLE_KEY=pk_test_xxx
CLERK_SECRET_KEY=sk_test_xxx
CLERK_WEBHOOK_SIGNING_SECRET=whsec_xxx

# ============================================================
# Billing — Stripe (dashboard.stripe.com)
# ============================================================
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
STRIPE_SUCCESS_URL=http://localhost:3000
STRIPE_CANCEL_URL=http://localhost:3000

# ============================================================
# AI / Generation APIs
# ============================================================
OPENAI_API_KEY=sk-proj-xxx
OPENROUTER_API_KEY=sk-or-v1-xxx
REPLICATE_API_KEY=r8_xxx
WAVESPEED_API_KEY=wsk_live_xxx
SEEDANCE_API_KEY=sk-xxx
WAYIN_API_KEY=sk_xxx
SUPADATA_API_KEY=sd_xxx
ELEVENLABS_API_KEY=

# ============================================================
# Video Rendering — Remotion (AWS Lambda)
# ============================================================
REMOTION_AWS_REGION=us-east-1
REMOTION_AWS_ACCESS_KEY_ID=AKIAXXXXXXXXXXXXXXXX
REMOTION_AWS_SECRET_ACCESS_KEY=xxx
REMOTION_LAMBDA_FUNCTION_NAME=remotion-render-x-x-xxx
REMOTION_SERVE_URL=https://remotionlambda-xxx.s3.us-east-1.amazonaws.com/sites/unsora-subtitle/index.html

# Optional: local ffmpeg/ffprobe overrides (set automatically by the Trigger.dev ffmpeg extension in deploys)
# FFMPEG_PATH=
# FFPROBE_PATH=

# ============================================================
# Storage — Supabase (primary media storage)
# Create a PUBLIC bucket named to match SUPABASE_STORAGE_BUCKET.
# ============================================================
SUPABASE_URL=https://xxx.supabase.co
SUPABASE_SECRET_KEY=sb_secret_xxx
SUPABASE_STORAGE_BUCKET=dev

# Optional: override media URL bases (defaults derived from Supabase config)
# MEDIA_STORAGE_BASE=
# MEDIA_CDN_BASE=

# ============================================================
# Background Jobs — Trigger.dev (cloud.trigger.dev)
# ============================================================
TRIGGER_PROJECT_REF=proj_xxx
TRIGGER_SECRET_KEY=tr_dev_xxx

# ============================================================
# Public API Keys — Unkey (for the public /api/v1 surface)
# Get these from https://app.unkey.com → create an API, then a Root Key.
# ============================================================
UNKEY_ROOT_KEY=unkey_xxx
UNKEY_API_ID=api_xxx

# ============================================================
# Social Connect — OAuth
# ============================================================
# Google / YouTube (console.cloud.google.com)
YOUTUBE_API_KEY=AIzaXXX
GOOGLE_CLIENT_ID=xxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-xxx
GOOGLE_REDIRECT_URI=http://localhost:8000/api/connect/google/callback

# TikTok (developers.tiktok.com)
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT=https://your-domain.com/api/connect/tt/callback

# Facebook (developers.facebook.com)
FB_APP_ID=
FB_APP_SECRET=
FB_REDIRECT=http://localhost:8000/api/connect/facebook/callback

# Instagram (developers.facebook.com — Instagram API use case)
IG_APP_ID=
IG_APP_SECRET=
IG_REDIRECT=https://localhost:8000/api/connect/instagram/callback

# LinkedIn (developer.linkedin.com — OpenID Connect sign-in + "Share on LinkedIn" product)
LINKEDIN_APP_ID=
LINKEDIN_APP_SECRET=
LINKEDIN_REDIRECT=https://localhost:8000/api/connect/linkedin/callback

# Bluesky (AT Protocol) OAuth — no app registration; client-metadata.json URL is the client_id.
# The private key (ES256 JWK JSON) authenticates the client; generate a separate one for prod.
BLUESKY_REDIRECT=https://your-domain.com/api/connect/bluesky/callback
BLUESKY_PRIVATE_KEY='{"kty":"EC","crv":"P-256","x":"...","y":"...","d":"...","alg":"ES256"}'

# Threads (separate Meta app / use case — own app id, tokens, graph.threads.net)
THREADS_APP_ID=
THREADS_APP_SECRET=
THREADS_REDIRECT=https://your-domain.com/api/connect/threads/callback

# Pinterest (v5 API; Trial Access app credentials)
PINTEREST_APP_ID=
PINTEREST_APP_SECRET=
PINTEREST_REDIRECT=https://your-domain.com/api/connect/pinterest/callback

# X (developer.x.com — OAuth 2.0 confidential client, "Read and write" app permissions)
X_CLIENT_ID=
X_CLIENT_SECRET=
X_REDIRECT=https://your-domain.com/api/connect/x/callback

# Google Business Profile — reuses GOOGLE_CLIENT_ID/SECRET; add this redirect URI to that
# OAuth client and enable the Business Profile APIs (access must be approved by Google).
GOOGLE_BUSINESS_REDIRECT=https://your-domain.com/api/connect/google_business/callback

# Webhook verify tokens & secrets (optional — for incoming platform webhooks)
# FB_WEBHOOK_VERIFY_TOKEN=
# IG_WEBHOOK_VERIFY_TOKEN=
# YOUTUBE_WEBHOOK_SECRET=
# TIKTOK_WEBHOOK_SECRET=

# ============================================================
# Monitoring — Sentry
# ============================================================
SENTRY_DSN=

# ============================================================
# Admin
# ============================================================
# Emails granted access to the /admin dashboard (comma separated)
ADMIN_EMAILS=

# ============================================================
# Email — Plunk (src/emails)
# ============================================================
# Secret key (sk_...) from the Plunk dashboard. Leave empty to send no mail.
PLUNK_SECRET_KEY=
# Sender address on a domain verified in Plunk, e.g. hello@tryunsora.com
PLUNK_FROM_EMAIL=
# Only for a self-hosted Plunk; defaults to https://next-api.useplunk.com
PLUNK_API_URL=
# Team inbox for new-signup / new-subscription notices (empty = not sent)
SIGNUP_NOTIFICATION_EMAIL=
# Balance that triggers the low-credit email (default 100)
LOW_CREDITS_THRESHOLD=
