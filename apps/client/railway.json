{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "buildCommand": "pnpm turbo run build --filter=@unsora/client",
    "watchPatterns": [
      "/apps/client/**",
      "!/apps/client/**/*.md",
      "/packages/**",
      "/package.json",
      "/pnpm-lock.yaml",
      "/pnpm-workspace.yaml",
      "/turbo.json",
      "/.node-version"
    ]
  },
  "deploy": {
    "startCommand": "npm --prefix apps/client start"
  }
}
