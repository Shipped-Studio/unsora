# ============================================================
# Auth — Clerk (dashboard.clerk.com)
# Must be the same Clerk instance as the server.
# ============================================================
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxx
CLERK_SECRET_KEY=sk_test_xxx
# Name of the Clerk JWT template used for API auth
CLERK_JWT_TEMPLATE=test

NEXT_PUBLIC_CLERK_SIGN_IN_URL=http://localhost:3000/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=http://localhost:3000/sign-up

# ============================================================
# Backend API (the Express server)
# ============================================================
NEXT_PUBLIC_API_URL=http://localhost:8000
API_URL=http://localhost:8000

# ============================================================
# Library imports (optional). Each source appears in the Library's
# Import menu only when its variables are set. Leave them empty to hide it.
# "App origins" below means every origin the web app runs on, e.g.
# http://localhost:3000 and https://app.tryunsora.com.
# ============================================================

# Google Drive: console.cloud.google.com
# 1. Enable "Google Drive API" and "Google Picker API" in one project.
# 2. OAuth consent screen: add the scope .../auth/drive.file.
# 3. Credentials > OAuth client ID > Web application. Authorized JavaScript
#    origins: the app origins. No redirect URI needed (token popup).
# 4. Credentials > API key, restricted to the Picker API and HTTP referrers
#    matching the app origins.
# 5. App ID is the project number (IAM & Admin > Settings).
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
NEXT_PUBLIC_GOOGLE_API_KEY=
NEXT_PUBLIC_GOOGLE_APP_ID=

# Dropbox: dropbox.com/developers/apps > Create app (Scoped access).
# Copy the App key. Settings > Chooser/Saver domains: add each app domain
# (e.g. localhost, app.tryunsora.com). No secret or redirect URI is used.
NEXT_PUBLIC_DROPBOX_APP_KEY=

# OneDrive: portal.azure.com > Microsoft Entra ID > App registrations.
# Supported account types: "Accounts in any organizational directory and
# personal Microsoft accounts". Authentication > Add a platform >
# Single-page application, redirect URI <app origin>/auth/popup.html for
# each app origin. API permissions: Microsoft Graph Files.Read (delegated);
# for work accounts also SharePoint MyFiles.Read or AllSites.Read
# (delegated). Personal accounts are asked for OneDrive.ReadWrite, which the
# consumer picker requires. Copy the Application (client) ID.
NEXT_PUBLIC_ONEDRIVE_CLIENT_ID=
